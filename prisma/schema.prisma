// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  email       String        @id
  password    String?
  role        Role          @default(DOSEN)
  status      AccountStatus @default(PENDING)
  profilDosen ProfilDosen?
  mataKuliah  MataKuliah[]
  rekapMateri RekapMateri[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("users")
}

model ProfilDosen {
  email     String   @id
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade)
  nama      String
  telepon   String?
  prodi     String?
  alamat    String?
  foto      String?  @default("/profil.png")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profil_dosen")
}

model MataKuliah {
  id          String        @id @default(cuid())
  kode        String?
  nama        String
  sks         Int?          @default(3)
  semester    String?
  dosenEmail  String
  dosen       User          @relation(fields: [dosenEmail], references: [email], onDelete: Cascade)
  rekapMateri RekapMateri[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("mata_kuliah")
}

model RekapMateri {
  id           String     @id @default(cuid())
  mataKuliahId String
  mataKuliah   MataKuliah @relation(fields: [mataKuliahId], references: [id], onDelete: Cascade)
  dosenEmail   String
  dosen        User       @relation(fields: [dosenEmail], references: [email], onDelete: Cascade)
  pertemuan    Int
  tanggal      DateTime   @default(now())
  materi       String
  tugas        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([mataKuliahId, pertemuan])
  @@map("rekap_materi")
}

enum Role {
  DOSEN
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

